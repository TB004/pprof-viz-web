{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pprof-Viz",
  "version": "0.1.0",
  "identifier": "com.tb004.pprof-viz",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "",
        "width": 1100,
        "height": 850,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "backgroundThrottling": "suspend",
        "focus": true,
        "preventOverflow": true,
        "shadow": true,
        "titleBarStyle": "Overlay",
        "devtools": false,
        "trafficLightPosition": {
          "x": 20,
          "y": 30
        }
      }
    ],
    "enableGTKAppId": true,
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:pprof-viz.db"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "msi", "appimage"],
    "publisher": "Tizian Bahr",
    "homepage": "https://github.com/TB004/pprof-viz",
    "copyright": "Copyright (c) 2026 Tizian Bahr",
    "category": "DeveloperTool",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "shortDescription": "Live visualizer for Go runtime metrics streamed via ConnectRPC",
    "longDescription": "Pprof-Viz is a desktop visualizer for the Go runtime/metrics stream. It connects to a ConnectRPC endpoint, samples CPU, GC, scheduler, and memory metrics in real time, and renders them as live charts.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "files": {}
      },
      "rpm": {
        "epoch": 0,
        "files": {},
        "release": "1"
      }
    },
    "macOS": {
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "height": 400,
          "width": 660
        }
      },
      "files": {},
      "hardenedRuntime": true,
      "minimumSystemVersion": "10.13"
    },
    "windows": {
      "allowDowngrades": true,
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "minimumWebview2Version": null,
      "nsis": null,
      "signCommand": null,
      "timestampUrl": "http://timestamp.digicert.com",
      "tsp": false,
      "webviewInstallMode": {
        "silent": true,
        "type": "downloadBootstrapper"
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
