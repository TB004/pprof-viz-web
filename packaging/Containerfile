# Build:  podman build --format docker -t pprof-viz-web -f packaging/Containerfile .
# Run:    podman run --rm -p 8080:80 pprof-viz-web
#
# Serving over plain HTTP on anything other than localhost leaves the browser
# without a secure context, which disables the service worker and persistent
# storage. Give SITE_ADDRESS a hostname, or put this behind a TLS proxy.

FROM docker.io/oven/bun:1.4.0-alpine AS build
WORKDIR /app

COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

COPY . .
RUN bun run build

FROM docker.io/library/caddy:2.11.4-alpine
COPY packaging/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/build /srv

LABEL org.opencontainers.image.source=https://github.com/TB004/pprof-viz-web
LABEL org.opencontainers.image.description="A self-hostable, installable web dashboard for visualizing Go runtime telemetry in real time."
LABEL org.opencontainers.image.licenses=GPL-3.0-or-later

EXPOSE 80 443
HEALTHCHECK --interval=30s --timeout=3s \
	CMD wget --spider -q http://127.0.0.1/ || exit 1
